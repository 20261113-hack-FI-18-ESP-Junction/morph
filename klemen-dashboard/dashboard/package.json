{
  "name": "morph-station-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "demo": "python3 ../tools/run_local_demo.py",
    "demo:all": "python3 ../tools/run_station.py demo",
    "demo:check": "tsx tools/checkLocalDemo.ts",
    "station:check": "python3 ../tools/check_station.py",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/services/m06Projection.test.ts src/services/history.test.ts src/services/stationClient.test.ts server/stationProxy.mac-baseline.test.ts server/stationProxy.mcp.test.ts server/mcpStationTransport.test.ts src/analysis/analysis.test.tsx server/mediaGateway.test.ts src/media/media.test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:prototype": "tsx --test src/domain/stationLogic.test.ts",
    "test:media": "tsx --test server/mediaGateway.test.ts src/media/media.test.ts"
  },
  "dependencies": {
    "@morph/station-client": "file:../station-client",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
