# Optional server environment. No provider is required to start the simulator.
# Configure actual values privately; this example is not automatically loaded.
GEMINI_API_KEY=
GOOGLE_API_KEY=
VERDA_INFERENCE_KEY=
# ElevenLabs remains optional under the owner's November 15 decision.
ELEVENLABS_API_KEY=
# Optional absolute path to an existing Python environment.
MORPH_PYTHON=
# Reserved for the FUTURE mission client; the current simulator does not read it.
# Use only the NVIDIA tunnel base URL supplied by the other team.
# This package does not implement or configure the tunnel.
MORPH_INTEL_BASE_URL=
